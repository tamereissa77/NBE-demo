# Copy to .env and adjust. Machine-specific values: this file is NOT portable between hosts.

# Published port for the gateway (the only port exposed on the host)
NBE_PORT=8200

# Postgres (internal network only)
POSTGRES_PASSWORD=change-me

# Key for the internal model gateway (LiteLLM). Generated by `make .env`.
LITELLM_MASTER_KEY=sk-change-me

# Bearer key for the D6 OpenAI-compatible endpoint at /v1 (Dataiku LLM Mesh, Open WebUI). Generated by `make .env`.
D6_API_KEY=change-me

# Model weights on the host, mounted read-only into model servers (Phase 1)
MODELS_DIR=/opt/models
HF_CACHE_DIR=/opt/huggingface-cache

# Used ONLY by `make models` (the one online step). Leave empty at demo time.
HF_TOKEN=

TZ=Africa/Cairo

# --- Workstation only (docker-compose.local.yml, docs/workstation.md) ---
# OpenRouter key for the hosted Gemma
OPENROUTER_API_KEY=
# NBE_ASR_AUTO_LANGUAGE=            # empty: QwenCleo-ASR detects the language itself (default: Arabic)
# NBE_RETRIEVAL_DEVICE=cpu          # embeddings and reranker on CPU (about 3 s per search)
# NBE_GPU_BASE=nbe-gpu-base:local   # an earlier docker/local-gpu build to reuse as the base image
# NBE_MIN_FREE_GB=20                # scripts/up_local.sh refuses to build below this much free disk
# D1 reads uploaded documents with a fine-tuned Qwen3-VL (nbe-docvlm). The project that trained it holds the
# serving code and the adapter; scripts/docvlm_libs.sh installs the extra Python packages once.
# NBE_DOCVLM_REPO=/path/to/loan        # contains nbe_finetune/ (demo/api.py, output/candidates/<adapter>)
# NBE_DOCVLM_ADAPTER=v18               # folder under nbe_finetune/output/candidates
# NBE_DOCVLM_LIBS=./ops/docvlm-libs    # where scripts/docvlm_libs.sh puts the packages

# --- Efada build on the GB10 (docker-compose.gb10.yml, scripts/up_gb10.sh) ---
# A second checkout on a shared box keeps its own images and data volumes, and every make target uses the overlay
# COMPOSE_PROJECT_NAME=efada
# IMAGE_TAG=efada
# COMPOSE_FILE=docker-compose.yml:docker-compose.gb10.yml
# EFADA_MODELS_DIR=/path/to/models     # QwenCleo-ASR, VoiceTut-TTS and the reader's base model (not in MODELS_DIR)
# NBE_DOCVLM_IMAGE=nbe-qwencleo:efada  # the image scripts/docvlm_libs.sh installs the reader's packages for
