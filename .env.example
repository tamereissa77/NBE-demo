# Copy to .env and adjust. Machine-specific values: this file is NOT portable between hosts.

# Published port for the gateway (the only port exposed on the host)
NBE_PORT=8200

# Postgres (internal network only)
POSTGRES_PASSWORD=change-me

# Key for the internal model gateway (LiteLLM). Generated by `make .env`.
LITELLM_MASTER_KEY=sk-change-me

# Model weights on the host, mounted read-only into model servers (Phase 1)
MODELS_DIR=/opt/models
HF_CACHE_DIR=/opt/huggingface-cache

# Used ONLY by `make models` (the one online step). Leave empty at demo time.
HF_TOKEN=

TZ=Africa/Cairo
