   "crop_path": "crops/legal_circular_2/page_018/legal_circular_2_p018_b09_text.png"
  },
  {
   "block_id": "legal_circular_2_p018_b10",
   "block_type": "header",
   "text": "٧- العملاء الذين أذمت مديونياتهم دون ابراء الذمة:",
