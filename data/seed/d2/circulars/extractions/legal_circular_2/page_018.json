   },
   "crop_path": "crops/legal_circular_2/page_018/legal_circular_2_p018_b05_text.png"
  },
  {
   "block_id": "legal_circular_2_p018_b06",
   "block_type": "header",
   "text": "٥- التصفية الرضائية:",
   "table_data": null,
   "bbox": {
    "x1": 1649,
    "y1": 1379,
    "x2": 2088,
    "y2": 1446
   },
   "crop_path": "crops/legal_circular_2/page_018/legal_circular_2_p018_b06_header.png"
  },
  {
   "block_id": "legal_circular_2_p018_b07",
   "block_type": "text",
   "text": "في حالة الاتفاق على تصفية أى من الشركات، يتعين على البنوك الاخطار عن هذه الشركة ويعتد بتاريخ شهر اسم المصفي واتفاق الشركاء بشأن طريقة التصفية في السجل التجاري وفي صحيفة الشركات.",
   "table_data": null,
   "bbox": {
