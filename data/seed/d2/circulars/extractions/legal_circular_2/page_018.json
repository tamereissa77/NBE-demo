  {
   "block_id": "legal_circular_2_p018_b02",
   "block_type": "header",
   "text": "٣- دعوى الصلح الواقعي من الافلاس:",
   "table_data": null,
   "bbox": {
    "x1": 1360,
    "y1": 435,
    "x2": 2093,
