# TEMPORARY development settings for docker-compose.api.yml. Append to .env (created by `make .env`).
# None of these are needed on the GB10.

# Chat model behind the workhorse/vision/quality/hero aliases, as a LiteLLM model string
# (provider/model), and the key for that provider.
NBE_API_MODEL=
NBE_API_KEY=

# Folder holding bge-m3/ and bge-reranker-v2-m3/ (scripts/dev_api.sh models downloads them, ~4.6 GB).
# In this mode both run on CPU, so no GPU memory settings are needed.
MODELS_DIR=/home/asoliman/models/nbe
